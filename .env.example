# AUDIO
RVC_MODEL_PATH=models/rvc/
OUTPUT_PATH=outputs/

# DOCKER
DOCKER_CONTAINER_NAME=orion-interface

# LOGGING
LOG_LEVEL=INFO

# PLATFORM INTEGRATIONS
TIKTOK_CLIENT_KEY=
