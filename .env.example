# AI MODELS
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=lightning-ai/deepseek-v4-pro

# OPENAI
OPENAI_API_KEY=your_openai_key_here

# LOCAL AI
LOCAL_MODEL_PATH=models/
LOCAL_MEMORY_PATH=memory/

# APP
APP_ENV=development
APP_PORT=5000
DEBUG=true

# DATABASE
DATABASE_URL=sqlite:///orion.db

# SECURITY
SECRET_KEY=change_this_secret_key

# AUDIO
RVC_MODEL_PATH=models/rvc/
OUTPUT_PATH=outputs/

# DOCKER
DOCKER_CONTAINER_NAME=orion-interface

# LOGGING
LOG_LEVEL=INFO
