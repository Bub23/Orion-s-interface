# AI MODELS
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# OPENAI
OPENAI_API_KEY=

# LOCAL AI
LOCAL_MODEL_PATH=models/
LOCAL_MEMORY_PATH=memory/

# APP
APP_ENV=development
APP_PORT=8000
DEBUG=true
MAX_UPLOAD_MB=250

# DATABASE
